USE_LAYER = None
USE_RAW = False
THRESHOLD = 0.0
MIN_POS_CELLS = 20

USE_FDR = False
P_CUTOFF = 0.05
FDR_CUTOFF = 0.05

FC_METHOD = "mean"        # "mean" or "median"
FC_PSEUDOCOUNT = 0.0

