# =========================
# 1) 你要比较的 pairs（g1 vs g2）
# =========================
pairs = [
    ("pre_nres_HSCLSC",   "post_nres_HSCLSC"),
    ("pre_nres_EMP",      "post_nres_EMP"),
    ("pre_nres_MPPCLP1",  "post_nres_MPPCLP1"),
]

# =========================
